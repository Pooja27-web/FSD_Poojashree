Count Buffering System 
 
Code: 
 
import React, { useState } from "react"; 
import "./style.css"; 
 
function Counter() { 
  const [count, setCount] = useState(0); 
 
  return ( 
    <div> 
      <h1 className="cou">Buffer System</h1> 
 
      <p className="cou">{count}</p> 
 
      <button className="center" onClick={() => setCount(count - 1)}> 
        Decrement 
      </button> 
 
      <button className="center" onClick={() => setCount(count + 1)}> 
        Increment 
      </button> 
 
      <button className="center" onClick={() => setCount(0)}> 
        Reset 
      </button> 
    </div> 
  ); 
} 
 
export default Counter; 
 
 
